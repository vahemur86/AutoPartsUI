import type { FC } from "react";
import i18next from "i18next";

// icons
import { Lock, Package } from "lucide-react";

// styles
import styles from "./LotSourceBadge.module.css";

interface LotSourceBadgeProps {
  isSpecial?: boolean;
}

export const LotSourceBadge: FC<LotSourceBadgeProps> = ({ isSpecial }) =>
  isSpecial ? (
    <span className={`${styles.badge} ${styles.special}`}>
      <Lock size={12} />
      {i18next.t("specialLots.badge.special")}
    </span>
  ) : (
    <span className={`${styles.badge} ${styles.general}`}>
      <Package size={12} />
      {i18next.t("specialLots.badge.general")}
    </span>
  );

interface LotCustomerCellProps {
  isSpecial?: boolean;
  customerId?: number | null;
  customerName?: string | null;
}

export const LotCustomerCell: FC<LotCustomerCellProps> = ({
  isSpecial,
  customerId,
  customerName,
}) => {
  if (!isSpecial) {
    return (
      <span className={styles.muted}>{i18next.t("specialLots.merged")}</span>
    );
  }

  return (
    <span className={styles.customerName}>
      {customerName ?? `#${customerId ?? "-"}`}
    </span>
  );
};
