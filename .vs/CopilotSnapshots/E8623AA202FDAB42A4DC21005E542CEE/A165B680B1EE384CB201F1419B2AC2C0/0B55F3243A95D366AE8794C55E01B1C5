foreach ($lang in $locales.Keys) {
  $path = "src/locales/$lang/translation.json"
  $json = Get-Content $path -Raw -Encoding UTF8 | ConvertFrom-Json
  $d = $locales[$lang]

  # top-level specialLots namespace
  $json | Add-Member -NotePropertyName specialLots -NotePropertyValue ($d.specialLots | ConvertTo-Json -Depth 10 | ConvertFrom-Json) -Force

  # customer type form + column
  $json.customerTypes.form | Add-Member -NotePropertyName preventInventoryMerge -NotePropertyValue $d.customerTypeForm.preventInventoryMerge -Force
  $json.customerTypes.form | Add-Member -NotePropertyName preventInventoryMergeHint -NotePropertyValue $d.customerTypeForm.preventInventoryMergeHint -Force
  $json.customerTypes.columns | Add-Member -NotePropertyName preventInventoryMerge -NotePropertyValue $d.customerTypeColumn -Force

  # inventory lots columns + filters
  $tb = $json.warehouses.totalBatches
  $tb.columns | Add-Member -NotePropertyName lotType -NotePropertyValue $d.lotType -Force
  $tb.columns | Add-Member -NotePropertyName specialCustomer -NotePropertyValue $d.specialCustomer -Force
  $tb.preview | Add-Member -NotePropertyName compositionTitle -NotePropertyValue $d.compositionTitle -Force
  $filters = [ordered]@{
    showGeneralLots = $d.showGeneralLots
    showSpecialLots = $d.showSpecialLots
    allSpecialCustomers = $d.allSpecialCustomers
  }
  $tb | Add-Member -NotePropertyName filters -NotePropertyValue ($filters | ConvertTo-Json | ConvertFrom-Json) -Force

  # reports navigation
  $json.reports.navigation | Add-Member -NotePropertyName specialLots -NotePropertyValue $d.navSpecialLots -Force

  $out = $json | ConvertTo-Json -Depth 100
  [System.IO.File]::WriteAllText((Resolve-Path $path), $out, (New-Object System.Text.UTF8Encoding $false))
  Write-Host "Updated $path"
}
